rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/staff_access/$(request.auth.token.email.lower()));
    }

    function staffRole() {
      return get(/databases/$(database)/documents/staff_access/$(request.auth.token.email.lower())).data.role;
    }

    function roleIs(role) {
      return staff() && staffRole() == role;
    }

    function hotelStaff() {
      return roleIs("admin") || roleIs("cashier");
    }

    function restaurantStaff() {
      return hotelStaff() || roleIs("cashier_restaurant");
    }

    function kitchenStaff() {
      return hotelStaff() || roleIs("kitchen");
    }

    function canCreateCustomerOrder() {
      return signedIn()
        && (request.auth.token.firebase.sign_in_provider == "anonymous" || restaurantStaff());
    }

    function admin() {
      return roleIs("admin");
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update, delete: if admin();
    }

    match /bookings/{bookingId} {
      allow create: if hotelStaff() || (request.resource.data.keys().hasOnly([
          "room_id", "guest_name", "guest_email", "guest_phone", "check_in",
          "check_out", "guests", "notes", "total", "status", "created_at",
          "rate_currency", "rate_period", "paid_amount", "payment_status", "payment_history",
          "created_by_uid"
        ])
        && request.resource.data.status == "pending"
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.room_id is string
        && exists(/databases/$(database)/documents/rooms/$(request.resource.data.room_id))
        && get(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)).data.active == true
        && request.resource.data.guest_name is string
        && request.resource.data.guest_name.size() > 0
        && request.resource.data.guest_name.size() <= 120
        && request.resource.data.guest_email is string
        && request.resource.data.guest_email.size() <= 254
        && request.resource.data.guest_phone is string
        && request.resource.data.guest_phone.size() <= 40
        && request.resource.data.check_in is string
        && request.resource.data.check_in.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.check_out is string
        && request.resource.data.check_out.matches("^\\d{4}-\\d{2}-\\d{2}$")
        && request.resource.data.check_out > request.resource.data.check_in
        && request.resource.data.guests is int
        && request.resource.data.guests > 0
        && request.resource.data.guests <= get(/databases/$(database)/documents/rooms/$(request.resource.data.room_id)).data.capacity
        && request.resource.data.total is number
        && request.resource.data.total >= 0
        && request.resource.data.rate_currency in ["LKR", "USD"]
        && request.resource.data.rate_period in ["night", "day"]
        && request.resource.data.paid_amount == 0
        && request.resource.data.payment_status == "unpaid"
        && request.resource.data.payment_history is list
        && request.resource.data.payment_history.size() == 0
        && (request.resource.data.notes == null || request.resource.data.notes is string)
        && request.resource.data.created_at is string);
      allow read: if restaurantStaff()
        || (signedIn() && resource.data.created_by_uid == request.auth.uid);
      allow update, delete: if hotelStaff();
    }

    match /room_night_locks/{lockId} {
      allow read: if true;
      allow write: if hotelStaff();
    }

    match /orders/{orderId} {
      allow read: if restaurantStaff() || kitchenStaff();
      allow create: if restaurantStaff();
      allow update: if admin()
        || (restaurantStaff()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "updated_at", "order_status_updated_at", "status_note", "status_history",
            "is_closed", "payment_status", "paid_amount", "payment_method", "payment_history",
            "refunded_amount"
          ])
          && (request.resource.data.status == resource.data.status
            || request.resource.data.status in ["placed", "in_prep", "ready", "delivered", "cancelled"])
          && request.resource.data.updated_at is string
          && (!("is_closed" in request.resource.data)
            || request.resource.data.is_closed is bool)
          && (!("paid_amount" in request.resource.data)
            || (request.resource.data.paid_amount is number && request.resource.data.paid_amount >= 0))
          && (!("payment_status" in request.resource.data)
            || request.resource.data.payment_status in ["paid", "unpaid", "partial", "refunded"]))
        || (roleIs("kitchen")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status", "updated_at", "order_status_updated_at", "status_note", "status_history",
            "is_closed"
          ])
          && request.resource.data.status in ["in_prep", "ready", "delivered"]
          && request.resource.data.updated_at is string
          && request.resource.data.order_status_updated_at is string
          && request.resource.data.status_note is string
          && request.resource.data.status_history is list
          && (!("is_closed" in request.resource.data)
            || request.resource.data.is_closed is bool));
      allow delete: if admin();
    }

    match /customer_order_requests/{requestId} {
      allow create: if canCreateCustomerOrder()
        && request.resource.data.keys().hasOnly([
          "customer_name", "customer_phone", "order_type", "order_reference",
          "items_summary", "items", "subtotal_estimate", "notes", "status", "created_at",
          "created_by_uid"
        ])
        && request.resource.data.keys().hasAll([
          "customer_name", "customer_phone", "order_type", "order_reference",
          "items_summary", "items", "subtotal_estimate", "notes", "status", "created_at",
          "created_by_uid"
        ])
        && request.resource.data.customer_name is string
        && request.resource.data.customer_name.size() > 0
        && request.resource.data.customer_name.size() <= 120
        && request.resource.data.customer_phone is string
        && request.resource.data.customer_phone.size() > 0
        && request.resource.data.customer_phone.size() <= 40
        && request.resource.data.order_type in ["dine_in", "takeaway", "room"]
        && (request.resource.data.order_reference == null
          || (request.resource.data.order_reference is string
            && request.resource.data.order_reference.size() <= 40))
        && request.resource.data.items_summary is string
        && request.resource.data.items_summary.size() > 0
        && request.resource.data.items_summary.size() <= 4000
        && request.resource.data.subtotal_estimate is number
        && request.resource.data.subtotal_estimate >= 0
        && request.resource.data.subtotal_estimate <= 10000000
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 30
        && request.resource.data.created_by_uid == request.auth.uid
        && (request.resource.data.notes == null
          || (request.resource.data.notes is string
            && request.resource.data.notes.size() <= 500))
        && request.resource.data.status == "pending"
        && request.resource.data.created_at is string;
      allow read: if restaurantStaff() || kitchenStaff()
        || (signedIn() && resource.data.created_by_uid == request.auth.uid);
      allow update: if restaurantStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "updated_at", "converted_order_id", "converted_order_no", "converted_total"
        ])
        && request.resource.data.status in [
          "pending", "confirmed", "in_prep", "ready", "completed", "cancelled"
        ]
        && request.resource.data.updated_at is string
        || (roleIs("kitchen")
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updated_at"])
          && request.resource.data.status in ["in_prep", "ready", "completed"]
          && request.resource.data.updated_at is string);
      allow delete: if admin();
    }

    match /counters/{counterId} {
      allow read, write: if restaurantStaff() && counterId == "orders";
    }

    match /petty_cash_accounts/{accountId} {
      allow read: if hotelStaff() && accountId == "current";
      allow create, update: if hotelStaff()
        && accountId == "current"
        && request.resource.data.balance is number
        && request.resource.data.balance >= 0
        && request.resource.data.updated_at is string
        && request.resource.data.updated_by is string;
      allow delete: if false;
    }

    match /petty_cash_entries/{entryId} {
      allow read: if hotelStaff();
      allow create: if hotelStaff()
        && request.resource.data.kind in ["top_up", "expense"]
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.amount <= 10000000
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 255
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 50
        && request.resource.data.created_at is string
        && request.resource.data.created_by is string;
      allow update: if false;
      allow delete: if false;
    }

    match /staff_access/{email} {
      allow read: if admin()
        || (signedIn()
          && request.auth.token.email.lower() == email);
      allow create, update, delete: if admin();
    }

    match /site_settings/{settingsId} {
      allow read: if settingsId == "public";
      allow create, update: if admin() && settingsId == "public";
      allow delete: if false;
    }

    match /contact_messages/{messageId} {
      allow create: if canCreateCustomerOrder()
        && request.resource.data.keys().hasOnly([
          "name", "email", "phone", "message", "status", "created_by_uid", "created_at"
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 254
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.created_by_uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.created_at is string;
      allow read: if hotelStaff();
      allow update: if hotelStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status"])
        && request.resource.data.status in ["new", "read"];
      allow delete: if admin();
    }
  }
}
